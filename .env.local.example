# Public app URL — used as the magic-link redirect base.
# Production: https://buildcost.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase — server only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anthropic — for Claude vision extraction (WS1) and QQP analysis (WS2)
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY
